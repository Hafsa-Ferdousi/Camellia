PORT=5000
MONGO_URI=mongodb://localhost:27017/camellia
NODE_ENV=development

# Used to sign JWT access tokens (15m) and the short-lived 2FA challenge token.
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES=15m

# Used for the CORS allow-list (must match exactly since refresh tokens use a cookie).
FRONTEND_URL=http://localhost:5173

# Bootstraps a single admin account on server startup — only if no admin
# exists yet, so it's safe to leave these set permanently. Required for the
# app to have an admin at all outside of running seed.js (seed.js also wipes
# products/categories, so don't run it against a production database).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PHONE=
ADMIN_SECURITY_QUESTION=What is the name of your first pet?
ADMIN_SECURITY_ANSWER=change_this_answer

# Email sending (free, via Gmail SMTP + nodemailer). Requires 2-Step
# Verification enabled on the Gmail account, then an App Password generated
# at: Google Account -> Security -> App Passwords. If left unset, email
# sending is skipped (a warning is logged) rather than breaking the app.
EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=your16charapppassword

# AI chatbot (customer support widget) — powered by Groq's free tier
# (no billing required, not region-gated like Google's). Get a key at
# https://console.groq.com/keys. If left unset, the chat widget replies with
# a fallback "unavailable" message instead of erroring.
GROQ_API_KEY=your_groq_api_key

# SMS sending (order-confirmation text after bKash payment is verified) via
# BulkSMSBD.net — register at https://bulksmsbd.net, top up prepaid SMS
# credit, and copy your API key + Sender ID from the dashboard. If left
# unset, SMS sending is skipped (a warning is logged) rather than breaking
# the app.
SMS_API_KEY=your_bulksmsbd_api_key
SMS_SENDER_ID=your_sender_id
