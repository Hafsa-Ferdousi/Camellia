PORT=5000
MONGO_URI=mongodb://localhost:27017/camellia
NODE_ENV=development

# Used to sign JWT access tokens (15m) and the short-lived 2FA challenge token.
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES=15m

# Needed to build links inside verification / password-reset emails, and for
# the CORS allow-list (must match exactly since refresh tokens use a cookie).
FRONTEND_URL=http://localhost:5173

# Optional: real email delivery via SMTP. If left unset, verification and
# password-reset emails are logged to the server console instead (handy for
# local development) with a devVerifyLink / devResetLink field in the API
# response so you can test the flow without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Camellia <no-reply@camellia.example>
