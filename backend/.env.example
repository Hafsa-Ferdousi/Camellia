PORT=5000
MONGO_URI=mongodb://localhost:27017/camellia
NODE_ENV=development

# Used to sign JWT access tokens (15m) and the short-lived 2FA challenge token.
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES=15m

# Used for the CORS allow-list (must match exactly since refresh tokens use a cookie).
FRONTEND_URL=http://localhost:5173
